{
  "name": "relgap",
  "short_name": "relgap",
  "description": "See everything between your pin and latest: merged, classified release notes with breaking changes first.",
  "start_url": "/",
  "display": "browser",
  "theme_color": "#7a2e63",
  "background_color": "#f7f7fa",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
