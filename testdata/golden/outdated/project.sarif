{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "relgap",
          "version": "dev",
          "informationUri": "https://github.com/sassdavid/relgap",
          "rules": [
            {
              "id": "breaking",
              "shortDescription": {
                "text": "The upgrade to the latest version has breaking changes"
              },
              "fullDescription": {
                "text": "The release notes from the pinned version to the latest version have entries classified as breaking at or above --min-confidence."
              },
              "help": {
                "text": "Read the digest the message names before you upgrade the pin."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "deprecation",
              "shortDescription": {
                "text": "The upgrade to the latest version has deprecations"
              },
              "fullDescription": {
                "text": "The release notes from the pinned version to the latest version have entries classified as deprecations at or above --min-confidence."
              },
              "help": {
                "text": "Read the digest the message names and move off the deprecated features before they go away."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "eol",
              "shortDescription": {
                "text": "The pinned release cycle has reached its end of life"
              },
              "fullDescription": {
                "text": "endoflife.date lists the release cycle of the pinned version as end of life, so it gets no more fixes."
              },
              "help": {
                "text": "Upgrade the pin to a supported release cycle."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "outdated",
              "shortDescription": {
                "text": "The pin is behind the latest version"
              },
              "fullDescription": {
                "text": "A newer stable version is out on the pin's release line."
              },
              "help": {
                "text": "Upgrade the pin; relgap digest lists what changed in between."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "failed",
              "shortDescription": {
                "text": "relgap couldn't check this pin or file"
              },
              "fullDescription": {
                "text": "A file didn't parse, or looking up the tool's versions failed."
              },
              "help": {
                "text": "Fix the file, or run relgap again with -v to see the failing request."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
