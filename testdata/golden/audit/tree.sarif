{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "relgap",
          "version": "dev",
          "informationUri": "https://github.com/sassdavid/relgap",
          "rules": [
            {
              "id": "failed",
              "shortDescription": {
                "text": "relgap couldn't check this pin or file"
              },
              "fullDescription": {
                "text": "A file didn't parse, or looking up the tool's versions failed."
              },
              "help": {
                "text": "Fix the file, or run relgap again with -v to see the failing request."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "unchecked",
              "shortDescription": {
                "text": "relgap didn't check this pin for vulnerabilities"
              },
              "fullDescription": {
                "text": "OSV wasn't asked about the pinned version, so no result here doesn't mean the version is clean. The message gives the reason: no-advisory-source, private-source, not-exact, unresolved, offline or failed."
              },
              "help": {
                "text": "Pin an exact version, or check the tool another way. Details: https://relgap.sasskovacs.dev/concepts/enrichment#unchecked-pins"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "GHSA-8394-6f8r-whxg",
              "shortDescription": {
                "text": "Terragrunt: Arbitrary File Deletion via Malicious Module Manifest"
              },
              "fullDescription": {
                "text": "Terragrunt: Arbitrary File Deletion via Malicious Module Manifest (CVE-2026-45099, GO-2026-6241)"
              },
              "help": {
                "text": "Upgrade past the affected versions. Details: https://osv.dev/vulnerability/GHSA-8394-6f8r-whxg"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "6.9",
                "tags": [
