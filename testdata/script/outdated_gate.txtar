# --fail-on and --max-behind on outdated and digest, and the exit codes: 3 for a match, 0
# without one, 2 for values the command doesn't check, and 1 when a tool fails and no gate
# matched. A failed tool can only hide findings, so a match on a partial report still exits 3.
# gate-added.yaml and gate-error-added.yaml hold the requests the first recordings lack (OSV,
# k9s's changelog files), so those recordings stay as they were.
env TEST_NOW=2026-11-11T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
cd project

# Usage errors exit 2 before any request.
! exec relgap outdated --fail-on drift
stderr 'fail-on drift isn''t checked by outdated: relgap outdated checks breaking, deprecation, eol, vuln or outdated'
! exec relgap digest --from-mise --fail-on eol
stderr 'fail-on eol isn''t checked by digest: relgap digest checks breaking or deprecation'
! exec relgap outdated --fail-on unknown
stderr 'flag --fail-on: policy.fail_on.0: value must be one of'
! exec relgap outdated --vuln-severity severe
stderr 'policy.vuln_severity'
! exec relgap outdated --min-count 0
stderr 'min-count must be at least 1, got 0'
! exec relgap outdated --max-behind weeks:2
stderr 'policy.max_behind'
! exec relgap digest --from-mise --format sarif
stderr 'format "sarif" is not supported by this command'
! exec relgap digest --from-mise --line major
stderr 'none of the others can be'
! exec relgap digest --all a b
stderr 'takes at most 1 argument'
exec expect-exit 2 relgap outdated --fail-on drift
exec expect-exit 2 relgap digest terraform

env TEST_CASSETTE=$CASSETTES/outdated/gate.yaml,$CASSETTES/outdated/gate-added.yaml
exec relgap outdated --format plain
cmp stdout ../outdated.txt
! stderr .

# k9s 0.50.16 is 3 releases (2 patches on its own line) behind 0.51.0, with 1 breaking change.
exec expect-exit 3 relgap outdated --fail-on outdated --format plain
stderr '^relgap: --fail-on outdated matched 1 pin: k9s 0.50.16 \(mise.toml:3\)$'
exec relgap outdated --fail-on outdated --max-behind releases:3 --format plain
exec expect-exit 3 relgap outdated --fail-on outdated --max-behind patch:1 --format plain
exec relgap outdated --fail-on outdated --max-behind minor:1 --format plain
exec expect-exit 3 relgap outdated --fail-on breaking --format plain
stderr '^relgap: --fail-on breaking matched 1 pin: k9s 0.50.16 \(mise.toml:3\)$'
exec expect-exit 3 relgap outdated --fail-on outdated --fail-on breaking --format plain
stderr '^relgap: --fail-on breaking matched 1 pin: k9s 0.50.16 \(mise.toml:3\); --fail-on outdated matched 1 pin: k9s 0.50.16 \(mise.toml:3\)$'
exec expect-exit 0 relgap outdated --fail-on breaking --min-count 2 --format plain

# policy.fail_on and policy.max_behind in the config work like the flags.
env RELGAP_POLICY_FAIL_ON=outdated
env RELGAP_POLICY_MAX_BEHIND=releases:2
exec expect-exit 3 relgap outdated --format plain
exec expect-exit 0 relgap outdated --max-behind releases:3 --format plain
env RELGAP_POLICY_FAIL_ON=
env RELGAP_POLICY_MAX_BEHIND=

exec expect-exit 3 relgap digest --from-mise --fail-on breaking --format plain
stderr 'fail-on breaking matched 1 pin: k9s 0.50.16'
[!recording] exec expect-exit 3 relgap digest k9s 0.50.16.. --fail-on breaking --format plain
[!recording] stderr '^relgap: --fail-on breaking matched 1 digest: k9s 0.50.16..0.51.0$'

# The second run answers from the HTTP cache.
[!recording] exec relgap outdated --offline --format plain
[!recording] cmp stdout ../outdated.txt

# A tool that fails exits 1 after printing the rest when no gate matches. k9s still has its
# breaking change, so --fail-on breaking exits 3 and warns that the report is partial.
cd ../broken
env TEST_CASSETTE=$CASSETTES/outdated/gate-error.yaml,$CASSETTES/outdated/gate-error-added.yaml
exec expect-exit 1 relgap outdated --fail-on outdated --max-behind releases:3 --format json
jsonschema outdated-v1.json stdout
stdout '"target": "ghost@mise.toml:2"'
stdout '"status": "error"'
stderr '^relgap: 1 pin or file failed; the report is partial$'
! stderr 'fail-on outdated matched'
exec expect-exit 3 relgap outdated --fail-on breaking --format json
stderr 'the report is partial; --fail-on matched anyway'
stderr '^relgap: --fail-on breaking matched 1 pin: k9s 0.50.16 \(mise.toml:3\)$'

-- outdated.txt --
TOOL  CURRENT  LATEST   BEHIND  BREAKING  DEPRECATION  EOL  VULNS  PIN
gh    2.103.3  2.103.3  0       0         0            -    0      mise.toml:2
k9s   0.50.16  0.51.0   3       1         0            -    -      mise.toml:3

1 of 2 compared pins are behind latest.
-- project/mise.toml --
[tools]
gh = "2.103.3"
k9s = "0.50.16"
-- broken/mise.toml --
[tools]
ghost = "1.0.0"
k9s = "0.50.16"
-- broken/.relgap.yaml --
schema_version: 1
tools:
  ghost: {repo: no-such-owner-relgap/no-such-repo}
