# registry lint reports unknown keys and bad regular expressions with file:line:column and exits 2.
exec expect-exit 2 relgap registry lint unknown-key.yaml bad-regex.yaml
! stdout .
cmp stderr lint-errors.txt

# The embedded entries and a valid file pass.
exec relgap registry lint
cmp stdout embedded.txt

exec relgap registry lint good.yaml --format json
jsonschema report-v1.json stdout
stdout '"good.yaml"'

-- unknown-key.yaml --
name: unknown-key
repo: acme/tool
version:
  scheme: semver
  tag_prefixx: "v"
sourcez: []
-- bad-regex.yaml --
name: bad-regex
repo: acme/tool
version:
  scheme: regex
  extract: "jdk-(\\d+"
sources:
  - kind: changelog-file
    path_template: CHANGELOG.md
    heading: "^v{version}[$"
-- good.yaml --
name: good
repo: acme/tool
-- lint-errors.txt --
relgap: invalid registry entries:
  unknown-key.yaml:5:3: version.tag_prefixx: unknown key
  unknown-key.yaml:6:1: sourcez: unknown key
  bad-regex.yaml:5:12: version.extract: bad regular expression: missing closing ): `jdk-(\d+`
  bad-regex.yaml:9:14: sources.0.heading: bad regular expression: missing closing ]: `[$`
-- embedded.txt --
valid: registry/argocd.yaml
valid: registry/awscli.yaml
valid: registry/claude-code.yaml
valid: registry/gh.yaml
valid: registry/go.yaml
valid: registry/golangci-lint.yaml
valid: registry/helm.yaml
valid: registry/k9s.yaml
valid: registry/kubectl.yaml
valid: registry/mise.yaml
valid: registry/node.yaml
valid: registry/opentofu.yaml
valid: registry/python.yaml
valid: registry/ruff.yaml
valid: registry/temurin.yaml
valid: registry/terraform-provider-aws.yaml
valid: registry/terraform-provider-kubernetes.yaml
valid: registry/terraform.yaml
valid: registry/terragrunt.yaml
valid: registry/uv.yaml
