# --min-confidence hides entries below the threshold and counts them as hidden. It replays the
# terraform cassette of digest_terraform, so it doesn't run while recording.
[recording] skip 'replays the cassette digest_terraform records'
env TEST_NOW=2026-11-10T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/gh-release/terraform-1.15.8..1.17.1.yaml

# 0 shows every entry, keyword-only guesses (0.4) and unmatched entries (0.3) included.
exec relgap digest terraform 1.15.8..1.17.1 --format json --min-confidence 0
stdout '"hidden": 0,'
stdout '"confidence": 0.3,'
stdout '"confidence": 0.4,'

# The default, 0.5, hides them.
exec relgap digest terraform 1.15.8..1.17.1 --format json
! stdout '"confidence": 0.3,'
! stdout '"confidence": 0.4,'
stdout '"hidden": [1-9][0-9]*,'

# 0.95 keeps only breaking-marker, breaking-heading and security-heading entries.
exec relgap digest terraform 1.15.8..1.17.1 --format json --min-confidence 0.95
stdout '"confidence": 0.95,'
! stdout '"confidence": 0.9,'
! stdout '"kind": "feature"'

# The environment variable and the config key work the same way.
env RELGAP_POLICY_MIN_CONFIDENCE=0.95
exec relgap digest terraform 1.15.8..1.17.1 --format plain
stdout '^breaking 1, deprecation 0, security 0, feature 0, fix 0, other 0; [0-9]+ below --min-confidence hidden$'

exec expect-exit 2 relgap digest terraform 1.15.8..1.17.1 --min-confidence 2
stderr 'min_confidence'
