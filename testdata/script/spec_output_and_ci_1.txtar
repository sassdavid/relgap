# The format × command cells of output-and-ci.md that no other script has a golden for: digest
# in tty and plain, and pins in all four formats. TestSpec_output_and_ci_1 checks that every cell
# of the table has a golden file that a script compares.
env TEST_NOW=2026-11-10T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/digest/kubectl-1.36.0..1.37.2.yaml

exec relgap digest kubectl 1.36.0..1.37.2 --format tty --color always
golden stdout digest/kubectl.tty
! stderr .

exec relgap digest kubectl 1.36.0..1.37.2 --format plain
golden stdout digest/kubectl.txt
! stderr .

# Formats a command doesn't have exit 2.
exec expect-exit 2 relgap digest kubectl 1.36.0..1.37.2 --format sarif
stderr 'format "sarif" is not supported by this command'
exec expect-exit 2 relgap pins project --format sarif
stderr 'format "sarif" is not supported by this command'

exec relgap pins project --format tty --color always
golden stdout pins/matrix.tty

exec relgap pins project --format plain
golden stdout pins/matrix.txt

exec relgap pins project --format md
golden stdout pins/matrix.md

exec relgap pins project --format json
jsonschema pins-v1.json stdout
golden stdout pins/matrix.json

-- project/.git/HEAD --
ref: refs/heads/main
-- project/mise.toml --
[tools]
terraform = "1.15.8"
helm = "3.21.0"
-- project/Dockerfile --
FROM golang:1.27.3
ARG KUBECTL_VERSION=1.34.2
-- project/versions.tf --
terraform {
  required_version = "~> 1.15"
}
