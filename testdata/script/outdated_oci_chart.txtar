# A helm pin whose oci:// registryUrl Artifact Hub doesn't list takes its versions from the
# registry's tags. plain's manifest names no source, so outdated shows latest and behind without
# counts, and the table shows the chart's short name.
env TEST_NOW=2026-11-20T00:00:00Z
env TEST_CASSETTE=$CASSETTES/non-github/oci-charts.yaml
exec relgap outdated --format json
stdout '"tool": "chart:oci://registry-1.docker.io/examplecharts/plain"'
stdout '"latest": "0.3.0"'
stdout 'names no GitHub repository in its source annotation'
exec relgap outdated --format plain
stdout '^chart:registry-1\.docker\.io/examplecharts/plain +0\.1\.0 +0\.3\.0 +2 '

-- versions.tf --
locals {
  # renovate: datasource=helm depName=plain registryUrl=oci://registry-1.docker.io/examplecharts
  plain = "0.1.0"
}
