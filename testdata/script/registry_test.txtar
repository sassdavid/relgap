# registry test runs each source of an entry on its own over a range, then all together. A YAML
# path runs that entry after the lint checks. It replays the argocd corpus cassette.
[recording] skip 'replays the cassette spec_source_adapters_2.txtar records'
env TEST_NOW=2026-11-12T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/corpus/argocd-3.5.0..3.6.1.yaml

exec relgap registry test argocd 3.5.0..3.6.1 --format plain
cmp stdout argocd.txt

exec relgap registry test argocd.yaml 3.5.0..3.6.1 --format json
stdout '"tool": "argocd"'
stdout '"kind": "upgrade-guide"'

exec expect-exit 2 relgap registry test broken.yaml 3.5.0..3.6.1
stderr 'broken.yaml:5:20: sources.0.path_template: unknown placeholder \{previous\}'
exec expect-exit 2 relgap registry test argocd
stderr 'takes 2 argument'

