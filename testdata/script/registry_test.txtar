-- argocd.yaml --
name: argocd
repo: argoproj/argo-cd
version: { scheme: semver, tag_prefix: "v" }
sources:
  - kind: upgrade-guide
    path_template: "docs/operator-manual/upgrading/{prev_minor}-{major}.{minor}.md"
    ref: master
-- broken.yaml --
name: broken
repo: o/r
sources:
  - kind: upgrade-guide
    path_template: "{previous}.md"
