# A chart digests the releases of the repository that holds it: argo-helm tags each chart as
# argo-cd-<version>, and the other charts' tags are dropped.
# Record again with: VCR_RECORD=1 GH_TOKEN=... go test ./internal/cli -run TestScripts/digest_chart
env TEST_NOW=2026-11-16T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/digest/chart-argo-cd-10.16.0..10.18.0.yaml

exec relgap digest chart:argo/argo-cd 10.16.0..10.18.0 --format json
golden stdout digest/chart-argo-cd.json
jsonschema digest-v1.json stdout
stdout '"repo": "argoproj/argo-helm"'
stdout '"adapter": "gh-release"'
! stdout 'argo-workflows-'
! stderr .
