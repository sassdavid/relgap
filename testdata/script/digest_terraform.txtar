# relgap digest replays a recorded GitHub session. terraform's registry entry reads CHANGELOG.md on
# the v<major>.<minor> branch, then the release bodies; bullets the body repeats are dropped. With a
# token relgap lists releases and fetches bodies over GraphQL. Without one it uses REST, warns once
# and drops to 2 concurrent requests; the digest is the same. Record again with: VCR_RECORD=1 GH_TOKEN=... go test ./internal/cli
env TEST_NOW=2026-11-10T12:00:00Z

# With a token: GraphQL.
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/gh-release/terraform-1.15.8..1.17.1.yaml
exec relgap digest terraform 1.15.8..1.17.1 --format json
cmp stdout digest.json
jsonschema digest-v1.json stdout
! stderr .

exec relgap digest terraform 1.15.8..1.17.1 --format plain
cmp stdout digest.txt
! stderr .

exec relgap digest terraform 1.15.8..1.17.1 --format md
golden stdout digest/terraform.md
! stderr .

exec relgap digest tf 1.15.8..1.17.1 --format tty --color always
stdout '^\x1b\[1mterraform 1\.15\.8\.\.1\.17\.1\x1b\[0m  hashicorp/terraform$'
stdout '^\x1b\[1m\x1b\[31mBreaking changes\x1b\[0m$'

exec relgap digest terraform 1.15.8..1.17.1 --format json -vv
stderr 'DBG github client authenticated=true token_source=GH_TOKEN concurrency=8'

# Without a token: REST, one warning, concurrency 2, the same digest.
env GH_TOKEN=
env TEST_CASSETTE=$CASSETTES/gh-release/terraform-1.15.8..1.17.1-notoken.yaml
exec relgap digest terraform 1.15.8..1.17.1 --format json
cmp stdout digest.json
stderr -count=1 '^.+$'
stderr 'WRN no GitHub token found; using the REST API \(60 requests per hour\) with 2 concurrent requests'

exec relgap digest terraform 1.15.8..1.17.1 --format json -vv
stderr -count=1 'WRN'
stderr 'DBG github client authenticated=false token_source="" concurrency=2'
! stderr 'Authorization'

