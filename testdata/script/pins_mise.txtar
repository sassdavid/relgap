# mise: every config file name, string, array and table values, ubi:, core: and dotted keys.
# A broken file is reported and the rest of the list still prints (exit 1).
env TEST_NOW=2026-11-11T00:00:00Z
! exec relgap pins --format json
jsonschema pins-v1.json stdout
golden stdout pins/mise.json
stderr 'can''t read pins repo=. file=broken/mise.toml error="mise: line 2: expected newline'
stderr '1 file\(s\) couldn''t be parsed; the list is partial'

-- mise.toml --
[env]
TERRAFORM_VERSION = "not a pin"

[tools]
terraform = "1.15.8"
node = ["26", "24.11.0"]
"ubi:cli/cli" = "v2.83.0"
"core:python" = "3.14"
helm = { version = "latest", os = ["linux"] }
tools.ignored = "this key sits under [tools], so it's tools.tools.ignored"

[tools."aqua:gruntwork-io/terragrunt"]
version = "1.2.1"

[tasks.lint]
run = "echo 1.0.0"
-- .mise.toml --
tools.kubectl = "1.34"
-- mise.ci.toml --
[tools]
"go:golang.org/x/vuln/cmd/govulncheck" = "1.9.0"
-- .config/mise/config.toml --
[tools]
uv = "0.9.5"
-- .config/mise/conf.d/extra.toml --
[tools]
k9s = "0.50.16"
-- other/conf.d/telegraf.toml --
[tools]
ignored = "1.0.0"
-- other/config.toml --
[tools]
ignored = "1.0.0"
-- broken/mise.toml --
[tools]
terraform = 1.15.8.0
