# kubectl's GitHub releases are boilerplate. Its notes come from CHANGELOG/CHANGELOG-1.xx.md on
# master, one file per minor, each fetched and parsed once. Entries under Dependencies are dropped
# (registry ignore_sections) and ACTION REQUIRED items are breaking (registry breaking_markers).
# Record again with: VCR_RECORD=1 GH_TOKEN=... go test ./internal/cli -run TestScripts/digest_kubectl
env TEST_NOW=2026-11-10T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/digest/kubectl-1.36.0..1.37.2.yaml

exec relgap digest kubectl 1.36.0..1.37.2 --format json
golden stdout digest/kubectl.json
jsonschema digest-v1.json stdout
! stderr .
! stdout '"Dependencies"'

exec relgap digest kubectl 1.36.0..1.37.2 --format md --md-max-chars 0
golden stdout digest/kubectl.md
! stderr .

# The full digest is longer than a GitHub comment, so the default --md-max-chars cuts it.
exec relgap digest kubectl 1.36.0..1.37.2 --format md
stdout 'Truncated to 60000 characters: cut \d+ sections, starting at "1\.37\.\d+"\.'
stdout 'Run `relgap digest --format json` for the full report\.$'

# --only lists the breaking and deprecation entries (the MCP breaking_changes tool); counts
# still cover every kind, and the text output has no other sections.
exec relgap digest kubectl 1.36.0..1.37.2 --only breaking --only deprecation --format json
golden stdout digest/kubectl-breaking.json
jsonschema digest-v1.json stdout
! stderr .
! stdout '"kind": "(fix|feature|other|security)"'
stdout '"fix": 193'

exec relgap digest kubectl 1.36.0..1.37.2 --only breaking --format plain
stdout 'Breaking changes'
! stdout '^(Deprecations|Fixes|Features|Other)$'
stdout 'breaking 4, deprecation 4'

exec expect-exit 2 relgap digest kubectl 1.36.0..1.37.2 --only fixes
stderr 'invalid kind "fixes": want one of breaking, deprecation, security, feature, fix, other'
exec expect-exit 2 relgap digest --from-mise --only breaking
stderr 'none of the others can be'
