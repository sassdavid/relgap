# Every --fail-on value exits 3 when it matches and 0 when it doesn't. TestSpec_output_and_ci_3
# checks that each value has both. kubectl 1.34.13 is 21 releases behind 1.37.2, on an EOL cycle,
# with breaking changes, deprecations and 2 OSV advisories without a CVSS rating. kubectl 1.37.2
# is current and supported, and has the same advisories; gh 2.103.3 has none.
env TEST_NOW=2026-11-12T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/digest/kubectl-1.36.0..1.37.2.yaml,$CASSETTES/enrich/outdated-eol.yaml,$CASSETTES/digest/helm-3.21.0..3.22.1.yaml

cd eol
exec expect-exit 3 relgap outdated --fail-on breaking --format plain
stderr '^relgap: --fail-on breaking matched 1 pin: kubectl 1\.34\.13 \(mise\.toml:2\)$'
exec expect-exit 3 relgap outdated --fail-on deprecation --format plain
stderr '^relgap: --fail-on deprecation matched 1 pin: kubectl 1\.34\.13 \(mise\.toml:2\)$'
exec expect-exit 3 relgap outdated --fail-on eol --format plain
stderr '^relgap: --fail-on eol matched 1 pin: kubectl 1\.34\.13 \(mise\.toml:2\)$'
exec expect-exit 3 relgap outdated --fail-on vuln --format plain
stderr '^relgap: --fail-on vuln matched 2 advisories: GO-2025-3521 in kubectl 1\.34\.13 \(mise\.toml:2\), GO-2025-3547 in kubectl 1\.34\.13 \(mise\.toml:2\)$'
exec expect-exit 3 relgap outdated --fail-on outdated --format plain
stderr '^relgap: --fail-on outdated matched 1 pin: kubectl 1\.34\.13 \(mise\.toml:2\)$'
exec expect-exit 3 relgap digest --from-mise --fail-on deprecation --format plain
stderr 'fail-on deprecation matched 1 pin: kubectl 1\.34\.13 \(mise\.toml:2\)$'

# The thresholds. An advisory without a rating doesn't reach any --vuln-severity. Each value
# counts its own findings against --min-count, and the error names only the values that reached it.
exec expect-exit 0 relgap outdated --fail-on vuln --vuln-severity low --format plain
exec expect-exit 3 relgap outdated --fail-on vuln --min-count 2 --format plain
exec expect-exit 0 relgap outdated --fail-on vuln --min-count 3 --format plain
exec expect-exit 0 relgap outdated --fail-on outdated --max-behind releases:21 --format plain
exec expect-exit 3 relgap outdated --fail-on outdated --max-behind releases:20 --format plain
exec expect-exit 3 relgap outdated --fail-on eol --fail-on vuln --min-count 2 --format plain
stderr '^relgap: --fail-on vuln matched 2 advisories: '
! stderr 'fail-on eol matched'

# policy.fail_on and policy.vuln_severity in the config work like the flags.
env RELGAP_POLICY_FAIL_ON=vuln
env RELGAP_POLICY_VULN_SEVERITY=critical
exec expect-exit 0 relgap outdated --format plain
env RELGAP_POLICY_VULN_SEVERITY=
exec expect-exit 3 relgap outdated --format plain
env RELGAP_POLICY_FAIL_ON=

cd ../supported
exec expect-exit 0 relgap outdated --fail-on breaking --format plain
exec expect-exit 0 relgap outdated --fail-on deprecation --format plain
exec expect-exit 0 relgap outdated --fail-on eol --format plain
exec expect-exit 3 relgap outdated --fail-on vuln --format plain
exec expect-exit 0 relgap outdated --fail-on outdated --format plain
exec expect-exit 0 relgap digest --from-mise --fail-on breaking --fail-on deprecation --format plain

env TEST_NOW=2026-11-11T12:00:00Z
env TEST_CASSETTE=$CASSETTES/outdated/gate.yaml,$CASSETTES/outdated/gate-added.yaml
cd ../novulns
exec expect-exit 0 relgap outdated --fail-on vuln --format plain
stdout '^gh +2\.103\.3 +2\.103\.3 +0 +0 +0 +- +0 '
env TEST_NOW=2026-11-12T12:00:00Z
env TEST_CASSETTE=$CASSETTES/digest/kubectl-1.36.0..1.37.2.yaml,$CASSETTES/digest/helm-3.21.0..3.22.1.yaml

# A single digest counts once. helm 3.21.0..3.22.1 has neither breaking changes nor deprecations.
cd ..
exec expect-exit 3 relgap digest kubectl 1.36.0..1.37.2 --fail-on breaking --format plain
stderr '^relgap: --fail-on breaking matched 1 digest: kubectl 1\.36\.0\.\.1\.37\.2$'
exec expect-exit 3 relgap digest kubectl 1.36.0..1.37.2 --fail-on deprecation --format plain
stderr '^relgap: --fail-on deprecation matched 1 digest: kubectl 1\.36\.0\.\.1\.37\.2$'
exec expect-exit 0 relgap digest kubectl 1.36.0..1.37.2 --fail-on breaking --min-count 2 --format plain
exec expect-exit 0 relgap digest helm 3.21.0..3.22.1 --fail-on breaking --fail-on deprecation --format plain

# drift counts drifted pins: terraform 1.14.2 in repos/a differs from 1.15.8 in b and c.
exec expect-exit 3 relgap drift repos --fail-on drift --format plain
stderr '^relgap: --fail-on drift matched 1 drifted pin: terraform \(1\.14\.2, 1\.15\.8\)$'
exec expect-exit 0 relgap drift repos --fail-on drift --min-count 2 --format plain
exec expect-exit 0 relgap drift agree --fail-on drift --format plain

-- eol/mise.toml --
[tools]
kubectl = "1.34.13"
-- supported/mise.toml --
[tools]
kubectl = "1.37.2"
-- novulns/mise.toml --
[tools]
gh = "2.103.3"
k9s = "0.50.16"
-- repos/a/.git/HEAD --
ref: refs/heads/main
-- repos/a/mise.toml --
[tools]
terraform = "1.14.2"
-- repos/b/.git/HEAD --
ref: refs/heads/main
-- repos/b/mise.toml --
[tools]
terraform = "1.15.8"
-- repos/c/.git/HEAD --
ref: refs/heads/main
-- repos/c/.terraform-version --
1.15.8
-- agree/a/.git/HEAD --
ref: refs/heads/main
-- agree/a/mise.toml --
[tools]
terraform = "1.15.8"
-- agree/b/.git/HEAD --
ref: refs/heads/main
-- agree/b/.terraform-version --
1.15.8
