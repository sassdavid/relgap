-- dotfiles/.git/HEAD --
ref: refs/heads/main
-- dotfiles/_mise/config.toml --
[settings]
experimental = true
lockfile = true

[tools]
age = "latest"
awscli = { version = "latest", symlink_bins = "true" }
dua = "3.0.0"
node = ["26", "24.11.0"]
java = "corretto-17"
python = "3.14"
"aqua:hashicorp/terraform" = "1.15.8"
terragrunt = { version = "1.2.1" }
hk = { version = "latest", workflow = "release.yml" }

[tools."http:kafka"]
version = "3.9.2"
url = "https://archive.apache.org/dist/kafka/{{ version }}/kafka_2.13-{{ version }}.tgz"
version_order = "semver"
bin_path = "bin"

[tools."github:mongodb/mongodb-atlas-cli"]
version = "1.40.0"
version_prefix = "atlascli/v"

[tools."http:mongodb-database-tools"]
version = "latest"
url = 'https://fastdl.mongodb.org/tools/db/mongodb-database-tools-{{ os(linux="ubuntu2404") }}-{{ version }}.zip'
strip_components = 1

[tools."http:mongodb-database-tools".platforms]
windows-x64 = { url = "https://fastdl.mongodb.org/tools/db/x.zip" }
-- dotfiles/_mise/conf.d/debian.toml --
[tools]
bat = "latest"
"aqua:sharkdp/fd" = "v0.10.2"
-- dotfiles/_mise/mise.lock --
[[tools.age]]
version = "1.3.2"
