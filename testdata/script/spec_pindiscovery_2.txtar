# A dotfiles-shaped mise config (array values, http:, github: and aqua: backends, [tools."http:..."]
# tables, conf.d) gives the same pins with and without mise on PATH. $FAKEMISE holds a mise whose
# `ls` would report other versions; the Go test checks that pins never runs it.
env TEST_NOW=2026-11-11T00:00:00Z
exec relgap pins --format json
jsonschema pins-v1.json stdout
golden stdout pins/dotfiles.json
cp stdout without-mise.json

exec relgap pins --format plain
cp stdout without-mise.txt

env PATH=$FAKEMISE${:}$PATH
exec relgap pins --format json
cmp stdout without-mise.json

exec relgap pins --format plain
cmp stdout without-mise.txt
cmp stdout want.txt

-- want.txt --
