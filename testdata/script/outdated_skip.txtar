# outdated looks up tfprovider: and chart: pins in the Terraform registry and Artifact Hub, and
# image: pins in their registry. It skips action: pins and images on a registry relgap doesn't
# read. With --offline and an empty cache every lookup fails without a request, so an error
# status shows that the lookup was tried. A chart whose repository URL
# fails the lookup keeps the URL in its name instead of searching by name.
[recording] stop
env RELGAP_CACHE_DIR=$WORK/empty-cache
env RELGAP_SCAN_DETECTORS_CI_ACTIONS=true
cd repo
exec expect-exit 1 relgap outdated --offline --format json
stdout '"tool": "image:node",\s+"pin": \{[^{}]*"location": \{[^{}]*\}\s*\},\s+"status": "error"'
stdout '"tool": "image:registry.example.com/team/app",\s+"pin": \{[^{}]*"location": \{[^{}]*\}\s*\},\s+"status": "skipped",\s+"note": "[^"]*registry not allowed: registry.example.com'
stdout '"tool": "action:actions/checkout",\s+"pin": \{[^{}]*"location": \{[^{}]*\}\s*\},\s+"status": "skipped"'
stdout '"tool": "tfprovider:hashicorp/aws",\s+"repo": "hashicorp/terraform-provider-aws",\s+"pin": \{[^{}]*"location": \{[^{}]*\}\s*\},\s+"status": "error"'
stdout '"tool": "chart:https://argoproj.github.io/argo-helm/argo-cd",\s+"pin": \{[^{}]*"location": \{[^{}]*\}\s*\},\s+"status": "error"'

# The table shows the chart by its short name, which resolve and digest accept too.
exec expect-exit 1 relgap outdated --offline --format plain
stdout '^chart:argoproj/argo-helm/argo-cd '
! stdout '^chart:https://'

-- repo/main.tf --
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "5.0.0"
    }
  }
}
-- repo/Chart.yaml --
apiVersion: v2
name: demo
version: 0.1.0
dependencies:
  - name: argo-cd
    version: 5.0.0
    repository: https://argoproj.github.io/argo-helm
-- repo/.github/workflows/ci.yml --
on: push
jobs:
  a:
    runs-on: ubuntu-latest
    container: node:20.11.0
  b:
    runs-on: ubuntu-latest
    container: registry.example.com/team/app:1.2.3
    steps:
      - run: true
    steps:
      - uses: actions/checkout@v4.1.0
