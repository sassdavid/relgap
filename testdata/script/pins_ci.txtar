# ci: image keys, a GitHub job container, *_VERSION and *-version keys. uses: lines count only
# with scan.detectors.ci_actions. A commit SHA with a full version in its line comment is exact
# at that version; a bare SHA or a major tag in the comment is not.
env TEST_NOW=2026-11-11T00:00:00Z
exec relgap pins --format json
jsonschema pins-v1.json stdout
golden stdout pins/ci.json

env RELGAP_SCAN_DETECTORS_CI_ACTIONS=true
exec relgap pins --format json
jsonschema pins-v1.json stdout
golden stdout pins/ci-actions.json

-- .github/workflows/ci.yml --
name: ci
on: push
env:
  TERRAFORM_VERSION: 1.15.8
jobs:
  test:
    runs-on: ubuntu-latest
    container: node:24.11.0
    services:
      db:
        image: postgres:18
    steps:
      - uses: actions/checkout@v5
      - uses: ./.github/actions/local
      - uses: docker://hashicorp/terraform:1.15.8
      - uses: actions/setup-go@v6
        with:
          go-version: "1.27"
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TERRAFORM_VERSION }}
      - uses: actions/download-artifact@fa0a91b85d4f404e444e00e005971372dc801d16 # v4.1.8
      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # renovate: tag=v4.3.0
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
-- .gitlab-ci.yml --
image:
  name: hashicorp/terraform:1.15.8
variables:
  TG_VERSION: "1.2.1"
-- bitbucket-pipelines.yml --
image: python:3.14
pipelines:
  default:
    - step:
        image: golang:1.27.3
        script:
          - make
