# drift --latest over the generated tree of 60 repositories adds a latest row with the newest
# stable version of each tool that has a GitHub repository, from one GraphQL request for all
# of them. Curated providers such as tfprovider:hashicorp/aws count. Image pins aren't looked up,
# and JSON says why.
env TEST_NOW=2026-11-11T12:00:00Z
env GH_TOKEN=$TEST_GH_TOKEN
env TEST_CASSETTE=$CASSETTES/drift/latest.yaml
gentree tree

requests reset
exec relgap drift tree --latest --format plain
golden stdout drift/latest.txt
requests 1
stdout '^latest +- +1\.37\.2 +26\.13\.1 +1\.17\.2 +6\.73\.0$'
stdout '^Not compared: go ≈1\.27 \(60 repos, latest 1\.27\.4\)$'

exec relgap drift tree --latest --format md
golden stdout drift/latest.md

exec relgap drift tree --latest --format json
jsonschema drift-v1.json stdout
stdout '"latest": "1\.17\.2"'
stdout '"note": "not looked up: unsupported tool syntax: unknown prefix \\"image:\\"'
stdout '"latest": "26\.13\.1"'
stdout '"latest": "6\.73\.0"'

# Later runs answer from the HTTP cache.
[!recording] requests reset
[!recording] exec relgap drift tree --latest --offline --format plain
[!recording] cmp stdout $GOLDEN/drift/latest.txt
[!recording] requests 0

# Without --latest, drift sends nothing, even with a token. The cassette is unset because a
# recording exec would overwrite it, and the proxy refuses every connection.
env TEST_CASSETTE=
env HTTPS_PROXY=http://127.0.0.1:1
requests reset
exec relgap drift tree --format plain
requests 0
